<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.sakana.mockdata.mapper.MockProductImageMapper">

    <insert id="batchInsert">
        insert into `product`.`product_image`
            (`id`, `product_id`, `url`, `type`, `sort`, `created_time`)
        values
        <foreach collection="list" item="it" separator=",">
            (#{it.id}, #{it.productId}, #{it.url}, #{it.type}, #{it.sort}, #{it.createdTime})
        </foreach>
    </insert>

    <update id="truncate">
        truncate table `product`.`product_image`
    </update>

</mapper>
