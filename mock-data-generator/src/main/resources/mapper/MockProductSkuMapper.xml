<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.sakana.mockdata.mapper.MockProductSkuMapper">

    <insert id="batchInsert">
        insert into `product`.`product_sku`
            (`id`, `product_id`, `sku_code`, `price`, `product_status`, `status`, `created_time`, `updated_time`)
        values
        <foreach collection="list" item="it" separator=",">
            (#{it.id}, #{it.productId}, #{it.skuCode}, #{it.price}, #{it.productStatus}, #{it.status},
             #{it.createdTime}, #{it.updatedTime})
        </foreach>
    </insert>

    <update id="truncate">
        truncate table `product`.`product_sku`
    </update>

</mapper>
