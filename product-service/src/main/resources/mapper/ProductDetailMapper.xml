<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="io.github.sakana.product.mapper.ProductDetailMapper">
    <select id="selectByProductIds" resultType="io.github.sakana.product.pojo.entity.ProductDetail">
        select *
        from product.product_detail
        where product_id in
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
    </select>
</mapper>
